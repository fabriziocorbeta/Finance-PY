<%= turbo_frame_tag "widget_sales_summary" do %>
  <div class="h-full rounded-xl bg-container p-5 shadow-border-xs">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-medium text-secondary">Ventas del mes</h3>
      <% if growth_percentage %>
        <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= growth_percentage >= 0 ? 'bg-emerald-500/10 text-emerald-600' : 'bg-rose-500/10 text-rose-600' %>">
          <%= growth_percentage >= 0 ? "+#{growth_percentage}%" : "#{growth_percentage}%" %> vs mes ant.
        </span>
      <% end %>
    </div>

    <p class="mt-3 text-2xl font-bold tracking-tight text-primary"><%= format_money(total_sales_money) %></p>

    <div class="mt-3 grid grid-cols-2 gap-3 border-t border-gray-200/60 dark:border-gray-700/60 pt-3 text-xs">
      <div>
        <span class="text-secondary">Operaciones</span>
        <p class="font-semibold text-primary"><%= sales_count %> <%= sales_count == 1 ? "venta" : "ventas" %></p>
      </div>
      <div>
        <span class="text-secondary">Ticket promedio</span>
        <p class="font-semibold text-primary"><%= format_money(average_ticket_money) %></p>
      </div>
    </div>
  </div>
<% end %>
