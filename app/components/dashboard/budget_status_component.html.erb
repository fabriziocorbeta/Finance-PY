<%= turbo_frame_tag "widget_budget_status" do %>
  <div class="h-full rounded-xl bg-container p-5 shadow-border-xs">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-medium text-secondary">Presupuesto del mes</h3>
      <span class="text-xs font-medium text-secondary"><%= status_label %></span>
    </div>

    <div class="mt-3 flex items-baseline justify-between gap-2">
      <p class="text-2xl font-bold tracking-tight text-primary"><%= format_money(spent_money) %></p>
      <p class="text-xs text-secondary">de <%= format_money(budgeted_money) %></p>
    </div>

    <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-gray-200/70 dark:bg-gray-700/70">
      <div class="h-full rounded-full transition-all <%= status_color %>"
           style="width: <%= [ percentage_used, 100 ].min %>%"></div>
    </div>

    <div class="mt-2 flex items-center justify-between text-xs text-secondary">
      <span><%= percentage_used %>% consumido</span>
      <span>
        <% if remaining_money.amount >= 0 %>
          Restan <%= format_money(remaining_money) %>
        <% else %>
          Excedido por <%= format_money(Money.new(remaining_money.amount.abs, family_currency)) %>
        <% end %>
      </span>
    </div>
  </div>
<% end %>
