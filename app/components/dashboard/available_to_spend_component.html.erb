<%= turbo_frame_tag "widget_available_to_spend" do %>
  <div class="h-full rounded-xl bg-container p-5 shadow-border-xs">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-medium text-secondary">Disponible para gastar</h3>
      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= low_balance? ? 'bg-red-500/10 text-red-600' : 'bg-emerald-500/10 text-emerald-600' %>">
        <%= low_balance? ? "Saldo bajo" : "Saludable" %>
      </span>
    </div>

    <p class="mt-3 text-2xl font-bold tracking-tight text-primary">
      <%= format_money(available_money) %>
    </p>

    <p class="mt-2 text-xs text-secondary">
      Consolidado de <%= liquid_accounts_count %> <%= liquid_accounts_count == 1 ? "cuenta líquida" : "cuentas líquidas" %> en <%= family_currency %>.
    </p>
  </div>
<% end %>
