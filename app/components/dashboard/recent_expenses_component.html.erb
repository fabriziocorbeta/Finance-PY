<%= turbo_frame_tag "widget_recent_expenses" do %>
  <div class="h-full rounded-xl bg-container p-5 shadow-border-xs">
    <div class="flex items-center justify-between gap-2">
      <h3 class="text-sm font-medium text-secondary">Últimos gastos</h3>
      <span class="text-xs font-semibold text-primary">
        Total: <%= format_money(total_recent_money) %>
      </span>
    </div>

    <% if expenses.any? %>
      <ul class="mt-3 divide-y divide-gray-200/60 dark:divide-gray-700/60">
        <% expenses.each do |entry| %>
          <li class="flex items-center justify-between gap-2 py-2 text-sm">
            <div class="min-w-0">
              <p class="truncate font-medium text-primary"><%= entry.name.presence || "Gasto" %></p>
              <p class="truncate text-xs text-secondary">
                <%= category_name(entry) %> · <%= l(entry.date, format: :short) %>
              </p>
            </div>
            <span class="shrink-0 font-semibold text-rose-600">
              -<%= format_money(to_family_money(entry.amount.abs, entry.currency, date: entry.date)) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-secondary">No se registraron gastos recientes.</p>
    <% end %>
  </div>
<% end %>
