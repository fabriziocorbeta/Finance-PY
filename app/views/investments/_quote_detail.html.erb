<%# locals: (quote:, range:, selected_ticker:, selected_mic: nil) %>

<section class="bg-container rounded-xl shadow-border-xs p-4 lg:p-6 space-y-5">
  <% if quote %>
    <% positive = quote.positive? %>
    <% day_color = positive ? "text-green-600" : "text-red-600" %>
    <% period_positive = quote.period_positive? %>
    <% period_color = period_positive ? "text-green-600" : "text-red-600" %>

    <% f = quote.fundamentals %>
    <%# Header: Ticker, Name, Category Badge, Price, Change, Watchlist Action %>
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-xl lg:text-2xl font-semibold text-primary"><%= quote.name %></h2>
          <span class="px-2 py-0.5 text-xs font-mono font-medium rounded-md bg-container-inset text-secondary">
            <%= quote.ticker %>
          </span>
          <span class="px-2 py-0.5 text-xs font-medium rounded-md bg-container-inset text-secondary">
            <%= t("investments.categories.#{quote.category}", default: quote.category.humanize) %>
          </span>
          <% if quote.exchange_name.present? %>
            <span class="text-xs text-subdued"><%= quote.exchange_name %></span>
          <% end %>
          <% if f&.market_state.present? %>
            <% state_label, state_cls = case f.market_state
               when "REGULAR" then [ t("investments.quote_detail.market_open"), "bg-green-500/10 text-green-600" ]
               when "PRE", "PREPRE" then [ t("investments.quote_detail.pre_market"), "bg-amber-500/10 text-amber-600" ]
               when "POST", "POSTPOST" then [ t("investments.quote_detail.after_hours"), "bg-indigo-500/10 text-indigo-600" ]
               else [ t("investments.quote_detail.market_closed"), "bg-container-inset text-secondary" ]
               end %>
            <span class="px-2 py-0.5 text-[11px] font-medium rounded-md <%= state_cls %>">
              <%= state_label %>
            </span>
          <% end %>
        </div>

        <div class="flex flex-wrap items-baseline gap-3">
          <span class="text-3xl font-semibold text-primary tabular-nums">
            <% if quote.current_price %>
              <%= number_with_delimiter(number_with_precision(quote.current_price, precision: 2)) %>
              <span class="text-sm font-normal text-secondary"><%= quote.currency %></span>
            <% else %>
              —
            <% end %>
          </span>

          <% if quote.change.present? && quote.change_percent.present? %>
            <span class="text-sm font-medium tabular-nums <%= day_color %>">
              <%= quote.change >= 0 ? "+" : "" %><%= number_with_precision(quote.change, precision: 2) %>
              (<%= quote.change_percent >= 0 ? "+" : "" %><%= number_with_precision(quote.change_percent, precision: 2) %>%)
              <span class="text-xs text-secondary font-normal"><%= t("investments.quote_detail.today") %></span>
            </span>
          <% end %>

          <% if quote.period_change.present? && quote.period_change_percent.present? %>
            <span class="text-sm font-medium tabular-nums <%= period_color %>">
              <%= quote.period_change >= 0 ? "+" : "" %><%= number_with_precision(quote.period_change, precision: 2) %>
              (<%= quote.period_change_percent >= 0 ? "+" : "" %><%= number_with_precision(quote.period_change_percent, precision: 2) %>%)
              <span class="text-xs text-secondary font-normal"><%= range.upcase %></span>
            </span>
          <% end %>
        </div>

        <% if f&.pre_market_price.present? || f&.post_market_price.present? %>
          <div class="flex flex-wrap items-center gap-4 text-xs text-secondary tabular-nums">
            <% if f.pre_market_price.present? %>
              <span>
                <%= t("investments.quote_detail.pre_market") %>:
                <strong class="text-primary"><%= number_with_delimiter(number_with_precision(f.pre_market_price, precision: 2)) %></strong>
                <% if f.pre_market_change_percent.present? %>
                  <span class="<%= f.pre_market_change_percent >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    (<%= f.pre_market_change_percent >= 0 ? "+" : "" %><%= number_with_precision(f.pre_market_change_percent, precision: 2) %>%)
                  </span>
                <% end %>
              </span>
            <% end %>
            <% if f.post_market_price.present? %>
              <span>
                <%= t("investments.quote_detail.after_hours") %>:
                <strong class="text-primary"><%= number_with_delimiter(number_with_precision(f.post_market_price, precision: 2)) %></strong>
                <% if f.post_market_change_percent.present? %>
                  <span class="<%= f.post_market_change_percent >= 0 ? 'text-green-600' : 'text-red-600' %>">
                    (<%= f.post_market_change_percent >= 0 ? "+" : "" %><%= number_with_precision(f.post_market_change_percent, precision: 2) %>%)
                  </span>
                <% end %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <%# Timeframe Selector %>
        <div class="inline-flex items-center gap-1 bg-container-inset p-1 rounded-lg">
          <% Investments::MarketTrackerService::RANGE_CONFIG.each_key do |r_key| %>
            <% is_active = (range == r_key) %>
            <%= link_to t("investments.ranges.#{r_key}", default: r_key.upcase),
                        quote_investments_path(ticker: selected_ticker, mic: selected_mic, range: r_key),
                        data: { turbo_frame: "market_quote_detail" },
                        class: class_names(
                          "px-2.5 py-1 text-xs font-medium rounded-md transition-colors",
                          is_active ? "bg-container text-primary shadow-xs" : "text-secondary hover:text-primary"
                        ) %>
          <% end %>
        </div>

        <% unless quote.category == "index" %>
          <%= link_to new_trade_investments_path(ticker: quote.ticker, price: quote.current_price),
                      data: { turbo_frame: :modal },
                      class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-inverse bg-inverse hover:bg-inverse-hover" do %>
            <%= icon("plus", size: "xs", color: "current") %>
            <span><%= t("investments.portfolio.add_holding") %></span>
          <% end %>
        <% end %>

        <% unless quote.watchlist_item.present? %>
          <%= button_to watchlist_items_path(ticker: quote.ticker, exchange_operating_mic: selected_mic),
                        method: :post,
                        data: { turbo_frame: "_top" },
                        class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-primary border border-secondary bg-container hover:bg-surface-hover cursor-pointer" do %>
            <%= icon("star", size: "xs") %>
            <span><%= t("investments.quote_detail.add_to_watchlist") %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Interactive D3 Time Series Chart %>
    <% if quote.series %>
      <div class="h-64 w-full">
        <div id="market-quote-chart-<%= quote.ticker.parameterize %>-<%= range %>"
             class="h-full w-full"
             data-controller="time-series-chart"
             data-time-series-chart-data-value="<%= quote.series.to_json %>"></div>
      </div>
    <% else %>
      <div class="h-48 w-full flex items-center justify-center rounded-lg bg-container-inset text-sm text-secondary">
        <%= t("investments.quote_detail.no_chart_data") %>
      </div>
    <% end %>

    <%# Key Market Stats (Yahoo / Google Finance style) %>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3 pt-2 border-t border-tertiary">
      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.previous_close") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <%= quote.previous_close ? number_with_delimiter(number_with_precision(quote.previous_close, precision: 2)) : "—" %>
        </p>
      </div>

      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.open_price") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <%= f&.open_price ? number_with_delimiter(number_with_precision(f.open_price, precision: 2)) : "—" %>
        </p>
      </div>

      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.day_range") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <% if quote.day_low && quote.day_high %>
            <%= number_with_precision(quote.day_low, precision: 2) %> – <%= number_with_precision(quote.day_high, precision: 2) %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.week52_range") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <% if quote.fifty_two_week_low && quote.fifty_two_week_high %>
            <%= number_with_precision(quote.fifty_two_week_low, precision: 2) %> – <%= number_with_precision(quote.fifty_two_week_high, precision: 2) %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.volume") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <%= quote.volume&.positive? ? number_to_human(quote.volume, precision: 2, significant: false, format: "%n%u", units: { thousand: "K", million: "M", billion: "B" }) : "—" %>
        </p>
      </div>

      <div class="bg-container-inset rounded-lg p-3">
        <p class="text-xs text-secondary"><%= t("investments.quote_detail.avg_volume") %></p>
        <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
          <%= f&.avg_volume&.positive? ? number_to_human(f.avg_volume, precision: 2, significant: false, format: "%n%u", units: { thousand: "K", million: "M", billion: "B" }) : "—" %>
        </p>
      </div>

      <% if f %>
        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.market_cap") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.market_cap&.positive? ? number_to_human(f.market_cap, precision: 2, significant: false, format: "%n%u", units: { million: "M", billion: "B", trillion: "T" }) : "—" %>
          </p>
        </div>

        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.pe_ratio") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.pe_ratio ? number_with_precision(f.pe_ratio, precision: 2) : "—" %>
          </p>
        </div>

        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.eps") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.eps ? number_with_precision(f.eps, precision: 2) : "—" %>
          </p>
        </div>

        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.dividend_yield") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.dividend_yield ? "#{number_with_precision(f.dividend_yield * 100, precision: 2)}%" : "—" %>
          </p>
        </div>

        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.beta") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.beta ? number_with_precision(f.beta, precision: 2) : "—" %>
          </p>
        </div>

        <div class="bg-container-inset rounded-lg p-3">
          <p class="text-xs text-secondary"><%= t("investments.quote_detail.target_price") %></p>
          <p class="text-sm font-medium text-primary tabular-nums mt-0.5">
            <%= f.target_mean_price ? number_with_delimiter(number_with_precision(f.target_mean_price, precision: 2)) : "—" %>
          </p>
        </div>
      <% end %>
    </div>

    <%# About / Company Profile & Events %>
    <% if f&.description.present? || f&.sector.present? || f&.earnings_date.present? %>
      <div class="pt-3 border-t border-tertiary space-y-2">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-medium text-primary">
            <%= t("investments.quote_detail.about") %> <%= quote.name %>
          </h3>
          <div class="flex flex-wrap items-center gap-2 text-xs text-secondary">
            <% if f.sector.present? %>
              <span class="px-2 py-0.5 rounded bg-container-inset"><%= f.sector %></span>
            <% end %>
            <% if f.industry.present? %>
              <span class="px-2 py-0.5 rounded bg-container-inset"><%= f.industry %></span>
            <% end %>
            <% if f.earnings_date.present? %>
              <span><%= t("investments.quote_detail.earnings_date") %>: <strong class="text-primary"><%= f.earnings_date %></strong></span>
            <% end %>
            <% if f.ex_dividend_date.present? %>
              <span><%= t("investments.quote_detail.ex_dividend_date") %>: <strong class="text-primary"><%= f.ex_dividend_date %></strong></span>
            <% end %>
          </div>
        </div>
        <% if f.description.present? %>
          <p class="text-xs text-secondary leading-relaxed line-clamp-3"><%= f.description %></p>
        <% end %>
      </div>
    <% end %>

    <%# Related News %>
    <% if quote.news.present? %>
      <div class="pt-3 border-t border-tertiary space-y-2.5">
        <h3 class="text-sm font-medium text-primary"><%= t("investments.quote_detail.news_title") %></h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
          <% quote.news.first(4).each do |article| %>
            <%= link_to article.link, target: "_blank", rel: "noopener noreferrer",
                        class: "block rounded-lg bg-container-inset p-3 hover:bg-surface-hover transition-colors" do %>
              <p class="text-xs font-medium text-primary line-clamp-2"><%= article.title %></p>
              <p class="text-[11px] text-secondary mt-1">
                <%= article.publisher %>
                <% if article.published_at.present? %>
                  · <%= Time.zone.parse(article.published_at)&.strftime("%d %b %H:%M") rescue nil %>
                <% end %>
              </p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="py-12 text-center text-sm text-secondary">
      <%= t("investments.quote_detail.unavailable") %>
    </div>
  <% end %>
</section>
