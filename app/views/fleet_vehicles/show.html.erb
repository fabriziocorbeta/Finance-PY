<%= content_for :page_title, @fleet_vehicle.plate %>
<%= content_for :page_actions do %>
  <%= render DS::Menu.new do |menu| %>
    <% menu.with_item(
      variant: "button",
      text: t("fleet_vehicles.show.delete"),
      href: fleet_vehicle_path(@fleet_vehicle),
      method: :delete,
      icon: "trash-2",
      confirm: t("fleet_vehicles.confirm_deletion", plate: @fleet_vehicle.plate)
    ) %>
  <% end %>

  <%= render DS::Link.new(
    text: t("fleet_vehicles.show.edit"),
    variant: "primary",
    icon: "pen",
    href: edit_fleet_vehicle_path(@fleet_vehicle)
  ) %>
<% end %>

<div class="space-y-6">
  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-4">
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.index.columns.brand") %></h4>
        <p class="text-primary mt-1"><%= @fleet_vehicle.brand %></p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.index.columns.model") %></h4>
        <p class="text-primary mt-1"><%= @fleet_vehicle.model %></p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.index.columns.year") %></h4>
        <p class="text-primary mt-1"><%= @fleet_vehicle.year.presence || "-" %></p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.index.columns.status") %></h4>
        <p class="text-primary mt-1 capitalize"><%= t("fleet_vehicles.statuses.#{@fleet_vehicle.status}") %></p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.show.average_efficiency") %></h4>
        <p class="text-primary mt-1">
          <% if @fleet_vehicle.average_fuel_efficiency %>
            <%= t("fleet_vehicles.show.efficiency_value", value: number_with_precision(@fleet_vehicle.average_fuel_efficiency, precision: 2)) %>
          <% else %>
            <%= t("fleet_vehicles.show.efficiency_no_data") %>
          <% end %>
        </p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.show.monthly_consumed") %></h4>
        <p class="text-primary mt-1">
          <%= t("fleet_vehicles.show.consumed_value", value: number_with_precision(@fleet_vehicle.monthly_fuel_consumed, precision: 2)) %>
        </p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.show.monthly_distance") %></h4>
        <p class="text-primary mt-1">
          <%= t("fleet_vehicles.show.distance_value", value: number_with_precision(@fleet_vehicle.monthly_distance, precision: 0)) %>
        </p>
      </div>
      <div>
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.show.monthly_efficiency") %></h4>
        <p class="text-primary mt-1">
          <% if @fleet_vehicle.monthly_average_efficiency %>
            <%= t("fleet_vehicles.show.efficiency_value", value: number_with_precision(@fleet_vehicle.monthly_average_efficiency, precision: 2)) %>
          <% else %>
            <%= t("fleet_vehicles.show.efficiency_no_data") %>
          <% end %>
        </p>
      </div>
    </div>
    <% if @fleet_vehicle.notes.present? %>
      <div class="mt-4 pt-4 border-t border-gray-100">
        <h4 class="text-xs font-medium text-secondary uppercase"><%= t("fleet_vehicles.notes") %></h4>
        <p class="text-sm text-secondary mt-1 whitespace-pre-wrap"><%= @fleet_vehicle.notes %></p>
      </div>
    <% end %>
  </div>

  <h2 class="text-lg font-medium text-primary"><%= t("fleet_vehicles.show.fuel_logs_history") %></h2>

  <div class="bg-container rounded-xl shadow-border-xs p-4">
    <% if @fleet_vehicle.fuel_logs.any? %>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-gray-100">
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider"><%= t("fuel_logs.columns.date") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider text-right"><%= t("fuel_logs.columns.liters") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider text-right"><%= t("fuel_logs.columns.cost") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider"><%= t("fuel_logs.columns.account") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider text-right"><%= t("fuel_logs.columns.odometer") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider"><%= t("fuel_logs.columns.notes") %></th>
              <th class="px-4 py-3 text-xs font-medium text-secondary uppercase tracking-wider"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @fleet_vehicle.fuel_logs.includes(:fuel_log_lines, :account).order(logged_at: :desc, created_at: :desc).each do |log| %>
              <tr class="hover:bg-gray-50/50">
                <td class="px-4 py-3 text-sm text-primary">
                  <%= l(log.logged_at.to_date, format: :short) %>
                </td>
                <td class="px-4 py-3 text-sm text-right text-primary">
                  <% if log.fuel_log_lines.any? %>
                    <%= log.fuel_log_lines.map { |line| "#{t("fuel_logs.fuel_types.#{line.fuel_type}")} #{number_with_precision(line.liters, precision: 2)}L" }.join(" + ") %>
                  <% else %>
                    <%= number_with_precision(log.liters, precision: 2) %>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-right text-primary font-medium">
                  <%= number_to_currency(log.cost, unit: "", separator: ",", delimiter: ".") %> <span class="text-xs uppercase text-secondary"><%= log.account.currency %></span>
                </td>
                <td class="px-4 py-3 text-sm text-primary truncate max-w-[150px]">
                  <%= log.account.name %>
                </td>
                <td class="px-4 py-3 text-sm text-right text-secondary">
                  <%= log.odometer.presence || "-" %>
                </td>
                <td class="px-4 py-3 text-sm text-secondary truncate max-w-[150px]">
                  <%= log.notes.presence || "-" %>
                </td>
                <td class="px-4 py-3 text-sm text-right">
                  <%= button_to fleet_vehicle_fuel_log_path(@fleet_vehicle, log), method: :delete, form: { data: { turbo_confirm: t("fuel_logs.confirm_deletion") } }, class: "text-secondary hover:text-red-600 p-1" do %>
                    <%= icon("trash-2", size: "sm", color: "current") %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-secondary py-4 text-center mb-6"><%= t("fleet_vehicles.show.no_fuel_logs") %></p>
    <% end %>

    <% new_log = @fleet_vehicle.fuel_logs.new %>
    <% new_log.fuel_log_lines.build if new_log.fuel_log_lines.empty? %>

    <div class="border-t border-gray-100 pt-6">
      <h3 class="text-md font-medium text-primary mb-4"><%= t("fleet_vehicles.show.add_fuel_log") %></h3>

      <%= styled_form_with model: [@fleet_vehicle, new_log], class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= f.date_field :logged_at, label: t("fuel_logs.columns.date"), required: true, value: Date.current %>
          <%= f.collection_select :account_id, Current.family.accounts.active.alphabetically, :id, :name, { prompt: t("fleet_vehicles.show.select_account") }, label: t("fuel_logs.columns.account"), required: true %>
          <%= f.number_field :odometer, label: t("fuel_logs.columns.odometer"), step: 1 %>
        </div>

        <div class="space-y-3 pt-2" data-controller="fuel-log-lines">
          <label class="text-xs font-medium text-secondary uppercase tracking-wide block"><%= t("fuel_logs.columns.liters") %> & <%= t("fuel_logs.columns.cost") %></label>

          <div data-fuel-log-lines-target="container" class="space-y-3">
            <%= f.fields_for :fuel_log_lines do |line_form| %>
              <div class="flex flex-wrap md:flex-nowrap items-end gap-2 p-3 rounded-lg border border-secondary bg-container" data-controller="element-removal">
                <div class="w-full md:flex-1">
                  <%= line_form.label :fuel_type, t("fleet_vehicles.show.fuel_type"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.select :fuel_type, FuelLogLine.fuel_types.keys.map { |k| [t("fuel_logs.fuel_types.#{k}"), k] }, {}, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="flex-1 md:w-32">
                  <%= line_form.label :liters, t("fuel_logs.columns.liters"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.number_field :liters, step: :any, min: 0.01, required: true, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="flex-1 md:w-36">
                  <%= line_form.label :cost, t("fuel_logs.columns.cost"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.number_field :cost, step: :any, min: 0, required: true, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="w-8 h-8 flex items-center justify-center shrink-0 mb-[2px]">
                  <button type="button" class="text-secondary hover:text-destructive transition-colors w-full h-full flex items-center justify-center" data-action="click->element-removal#remove" title="Remove item">
                    <%= icon "trash-2", size: "sm", color: "current" %>
                  </button>
                </div>
              </div>
            <% end %>
          </div>

          <template data-fuel-log-lines-target="template">
            <%= f.fields_for :fuel_log_lines, FuelLogLine.new, child_index: "NEW_RECORD" do |line_form| %>
              <div class="flex flex-wrap md:flex-nowrap items-end gap-2 p-3 rounded-lg border border-secondary bg-container" data-controller="element-removal">
                <div class="w-full md:flex-1">
                  <%= line_form.label :fuel_type, t("fleet_vehicles.show.fuel_type"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.select :fuel_type, FuelLogLine.fuel_types.keys.map { |k| [t("fuel_logs.fuel_types.#{k}"), k] }, {}, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="flex-1 md:w-32">
                  <%= line_form.label :liters, t("fuel_logs.columns.liters"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.number_field :liters, step: :any, min: 0.01, required: true, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="flex-1 md:w-36">
                  <%= line_form.label :cost, t("fuel_logs.columns.cost"), class: "text-xs font-medium text-secondary uppercase tracking-wide block mb-1" %>
                  <%= line_form.number_field :cost, step: :any, min: 0, required: true, class: "form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" %>
                </div>
                <div class="w-8 h-8 flex items-center justify-center shrink-0 mb-[2px]">
                  <button type="button" class="text-secondary hover:text-destructive transition-colors w-full h-full flex items-center justify-center" data-action="click->element-removal#remove" title="Remove item">
                    <%= icon "trash-2", size: "sm", color: "current" %>
                  </button>
                </div>
              </div>
            <% end %>
          </template>

          <div class="pt-1">
            <button type="button" data-action="click->fuel-log-lines#add" class="text-xs font-medium text-primary hover:underline inline-flex items-center gap-1">
              <%= icon "plus", size: "xs" %>
              <%= t("fleet_vehicles.show.add_fuel_line") %>
            </button>
          </div>
        </div>

        <div>
          <%= f.text_field :notes, label: t("fuel_logs.columns.notes") %>
        </div>

        <div class="flex justify-end pt-2">
          <%= f.submit t("fleet_vehicles.show.save_fuel_log") %>
        </div>
      <% end %>
    </div>
  </div>
</div>
