<head>
  <title><%= content_for(:title) || product_name %></title>

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

  <%# Primary variable font used for all text; preload so it doesn't wait on CSSOM to be discovered %>
  <link rel="preload" as="font" type="font/woff2" href="<%= asset_path("geist/Geist[wght].woff2") %>" crossorigin>

  <%= combobox_style_tag %>

  <%= javascript_importmap_tags %>
  <%= render "layouts/dark_mode_check" %>
  <%= render "layouts/privacy_mode_check" %>
  <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

  <%# Turbo Drive prefetches every visible link on hover/render by default.
      This notebook host runs Puma with only 2 workers x 5 threads (2 CPU
      cores, ~90MB free RAM under normal load) -- a burst of sidebar +
      per-account sparkline links prefetching at once queues real navigation
      behind them, measured at a genuine 7s wait for one visitor even with a
      warm boot. Scaling Puma up isn't safe here (RAM headroom too thin);
      disabling prefetch removes the self-inflicted burst instead. %>
  <meta name="turbo-prefetch" content="false">

  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">

  <%# Set --app-height synchronously (before layout) so the vertically-centered
      auth/onboarding screens don't jump once viewport_controller's Stimulus
      connect() callback runs post-paint with a different value than the
      100dvh fallback. Must run after the viewport meta tag above so
      window.innerHeight reflects the real mobile viewport, not the desktop
      default used before that meta tag is applied. %>
  <script nonce="<%= content_security_policy_nonce %>">
    document.documentElement.style.setProperty("--app-height", window.innerHeight + "px");
  </script>

  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="<%= product_name %>">
  <meta name="color-scheme" content="dark light">

  <%# Use theme colors that match both light and dark modes %>
  <meta name="msapplication-TileColor" content="#0B0B0B">
  <meta name="theme-color" content="#F9F9F9" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0B0B0B" media="(prefers-color-scheme: dark)">

  <link rel="manifest" href="<%= pwa_manifest_path %>">
  <%# Provide multiple iOS icons (standard 180x180 and larger) %>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="apple-touch-icon" sizes="512x512" href="/logo-pwa.png">
  <link rel="icon" sizes="192x192" type="image/png" href="/android-chrome-192x192.png">

  <% if Rails.env.production? && (posthog_config = Rails.configuration.x.posthog).try(:api_key).present? %>
    <%= render "shared/posthog", posthog_api_key: posthog_config.api_key, posthog_host: posthog_config.host %>
  <% end %>

  <%= yield :head %>
</head>
