<%# locals: (entry:, fleet_vehicles:) %>
<% existing_fl = entry.fuel_log %>
<% fuel_log_for_form = existing_fl || fleet_vehicles.first.fuel_logs.new(entry: entry, account: entry.account, logged_at: entry.date) %>
<% fuel_log_for_form.fuel_log_lines.build(cost: entry.amount.abs) if fuel_log_for_form.fuel_log_lines.empty? %>

<div id="<%= dom_id(entry, :fuel_log_section) %>" class="px-3 py-2">
  <%= form_with url: transaction_path(entry), method: :patch, class: "space-y-3" do %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div>
        <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1">Vehículo</label>
        <select name="fuel_log[fleet_vehicle_id]" class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" required>
          <% fleet_vehicles.each do |v| %>
            <option value="<%= v.id %>" <%= "selected" if v.id == fuel_log_for_form.fleet_vehicle_id %>><%= [v.plate, v.brand, v.model].compact.join(" · ") %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1">Odómetro (km)</label>
        <input type="number" step="1" name="fuel_log[odometer]" value="<%= fuel_log_for_form.odometer&.to_i %>" class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" />
      </div>
    </div>

    <div class="space-y-2" data-controller="fuel-log-lines">
      <label class="text-xs font-medium text-secondary uppercase tracking-wide block">Detalle por tipo de combustible</label>
      <div data-fuel-log-lines-target="container" class="space-y-2">
        <% fuel_log_for_form.fuel_log_lines.each_with_index do |line, idx| %>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-2.5 rounded-lg border border-secondary bg-container" data-controller="element-removal fuel-type-selector">
            <input type="hidden" name="fuel_log[fuel_log_lines_attributes][<%= idx %>][id]" value="<%= line.id %>" />
            <div>
              <label class="text-[11px] text-secondary block mb-0.5">Tipo</label>
              <select name="fuel_log[fuel_log_lines_attributes][<%= idx %>][fuel_type]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" data-fuel-type-selector-target="fuelType" data-action="change->fuel-type-selector#updateBrands">
                <% FuelLogLine.fuel_types.keys.each do |k| %>
                  <option value="<%= k %>" <%= "selected" if line.fuel_type == k %>><%= t("fuel_logs.fuel_types.#{k}") %></option>
                <% end %>
              </select>
            </div>
            <div class="<%= 'hidden' unless %w[nafta diesel].include?(line.fuel_type.to_s) %>" data-fuel-type-selector-target="brandContainer">
              <label class="text-[11px] text-secondary block mb-0.5">Marca</label>
              <select name="fuel_log[fuel_log_lines_attributes][<%= idx %>][brand]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" data-fuel-type-selector-target="brandSelect" data-prompt="<%= t("fleet_vehicles.show.select_brand") %>">
                <option value=""><%= t("fleet_vehicles.show.select_brand") %></option>
                <% FuelLogLine.brands_for(line.fuel_type).each do |b| %>
                  <option value="<%= b %>" <%= "selected" if line.brand == b %>><%= b %></option>
                <% end %>
              </select>
            </div>
            <div>
              <label class="text-[11px] text-secondary block mb-0.5">Litros</label>
              <input type="number" step="any" min="0.01" required name="fuel_log[fuel_log_lines_attributes][<%= idx %>][liters]" value="<%= line.liters %>" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" />
            </div>
            <div class="flex items-end gap-1">
              <div class="flex-1">
                <label class="text-[11px] text-secondary block mb-0.5">Monto</label>
                <input type="number" step="any" min="0" required name="fuel_log[fuel_log_lines_attributes][<%= idx %>][cost]" value="<%= line.cost %>" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" />
              </div>
              <button type="button" class="text-secondary hover:text-destructive p-1" data-action="click->element-removal#remove" title="Quitar">
                <%= icon "trash-2", size: "xs", color: "current" %>
              </button>
            </div>
          </div>
        <% end %>
      </div>

      <template data-fuel-log-lines-target="template">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 p-2.5 rounded-lg border border-secondary bg-container" data-controller="element-removal fuel-type-selector">
          <div>
            <label class="text-[11px] text-secondary block mb-0.5">Tipo</label>
            <select name="fuel_log[fuel_log_lines_attributes][NEW_RECORD][fuel_type]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" data-fuel-type-selector-target="fuelType" data-action="change->fuel-type-selector#updateBrands">
              <% FuelLogLine.fuel_types.keys.each do |k| %>
                <option value="<%= k %>"><%= t("fuel_logs.fuel_types.#{k}") %></option>
              <% end %>
            </select>
          </div>
          <div class="hidden" data-fuel-type-selector-target="brandContainer">
            <label class="text-[11px] text-secondary block mb-0.5">Marca</label>
            <select name="fuel_log[fuel_log_lines_attributes][NEW_RECORD][brand]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" data-fuel-type-selector-target="brandSelect" data-prompt="<%= t("fleet_vehicles.show.select_brand") %>">
              <option value=""><%= t("fleet_vehicles.show.select_brand") %></option>
            </select>
          </div>
          <div>
            <label class="text-[11px] text-secondary block mb-0.5">Litros</label>
            <input type="number" step="any" min="0.01" required name="fuel_log[fuel_log_lines_attributes][NEW_RECORD][liters]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" />
          </div>
          <div class="flex items-end gap-1">
            <div class="flex-1">
              <label class="text-[11px] text-secondary block mb-0.5">Monto</label>
              <input type="number" step="any" min="0" required name="fuel_log[fuel_log_lines_attributes][NEW_RECORD][cost]" class="form-field__input border border-secondary rounded px-2 py-1 w-full text-xs bg-container" />
            </div>
            <button type="button" class="text-secondary hover:text-destructive p-1" data-action="click->element-removal#remove" title="Quitar">
              <%= icon "trash-2", size: "xs", color: "current" %>
            </button>
          </div>
        </div>
      </template>

      <button type="button" data-action="click->fuel-log-lines#add" class="text-xs font-medium text-primary hover:underline inline-flex items-center gap-1">
        <%= icon "plus", size: "xs" %>
        <span>Agregar otro combustible</span>
      </button>
    </div>

    <div>
      <label class="text-xs font-medium text-secondary uppercase tracking-wide block mb-1">Notas de carga</label>
      <input type="text" name="fuel_log[notes]" value="<%= fuel_log_for_form.notes %>" class="form-field__input border border-secondary rounded-md px-2.5 py-1.5 w-full text-sm text-primary bg-container" />
    </div>

    <div class="flex justify-end">
      <%= render DS::Button.new(
        text: "Guardar carga de combustible",
        variant: :primary,
        size: :sm,
        type: :submit,
        data: { turbo_submits_with: "Guardando..." }
      ) %>
    </div>
  <% end %>
</div>
