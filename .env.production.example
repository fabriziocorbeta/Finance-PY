# FinancePY — Variables de producción
# Copiar a .env y completar:  cp .env.production.example .env

# Generar con: openssl rand -hex 64
SECRET_KEY_BASE=

# Supabase Postgres — proyecto existente "CD Finanzas", schema separado `financespy`
# 1. SQL Editor en Supabase:  create schema if not exists financespy;
# 2. Dashboard → Connect → Session pooler (IPv4, puerto 5432)
# 3. Agregar al final:  ?schema_search_path=financespy,extensions,public
# Formato: postgresql://postgres.XXXX:PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres?schema_search_path=financespy,extensions,public
DATABASE_URL=

# Dominio
APP_DOMAIN=finance.cd-co.com.py

# Branding (visible en footer, emails, título)
PRODUCT_NAME=FinancePY
BRAND_NAME=CD & Co.

# Seguridad — ver wiki/emprendimientos/financespy-auditoria-seguridad-2026-07-14.md
# onboarding_state: open (default) | invite_only | closed. Cerrar registro público:
ONBOARDING_STATE=closed
# Proveedor de tipos de cambio históricos. yahoo_finance no necesita API key
# (funciona out-of-the-box). twelve_data es mejor calidad pero requiere
# TWELVE_DATA_API_KEY (no hay campo en /settings/providers para cargarla
# hoy, solo vía env var).
EXCHANGE_RATE_PROVIDER=yahoo_finance
# Allowlist CORS para API/OAuth/sessions (separado por comas si hay más de un origin)
CORS_ALLOWED_ORIGINS=https://finance.cd-co.com.py
# CSP en report-only hasta confirmar que los reportes de violación están limpios,
# después cambiar a false para enforce real
CSP_REPORT_ONLY=true

# AI statement parser (Claude)
ANTHROPIC_API_KEY=

# Opcional — chat AI de Sure (incurre costos)
OPENAI_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OBLIGATORIAS. compose.prod.yml las declara con `:?`, así que si falta
# cualquiera de las tres el stack SE NIEGA A ARRANCAR. Eso es a propósito:
# arrancar sin ellas dejaría los campos cifrados ilegibles.
#
# Generar las tres de una:  bin/rails db:encryption:init
#
# ⚠️  Si se pierden, los datos cifrados (email, nombres, notas, archivos
# subidos, tokens bancarios) quedan ilegibles PARA SIEMPRE. Guardar una copia
# fuera de la máquina antes de poner esto en producción.
# ---------------------------------------------------------------------------
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Basic auth del panel de Sidekiq (/sidekiq), solo en production.
# Si quedan vacías, config/initializers/sidekiq.rb genera una credencial
# aleatoria NUEVA EN CADA REQUEST: el stack arranca igual pero al panel no
# entra nadie. No hay credencial por default, a propósito.
# Generar la contraseña con: openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | cut -c1-32
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=
