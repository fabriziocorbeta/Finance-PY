{
	"devDependencies": {
		"@biomejs/biome": "^1.9.3",
		"@capacitor/cli": "^8.5.0"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.0",
		"@capacitor/core": "^8.5.0"
	},
	"name": "sure",
	"version": "1.0.0",
	"description": "The personal finance app for everyone",
	"scripts": {
		"style:check": "biome check",
		"style:fix": "biome check --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"format:check": "biome format",
		"format": "biome format --write",
		"tokens:build": "node bin/tokens.mjs",
		"tokens:check": "node bin/tokens.mjs && git diff --quiet -- app/assets/tailwind/sure-design-system/_generated.css",
		"android:add": "cap add android",
		"android:sync": "cap sync android",
		"android:open": "cap open android",
		"android:link-native": "bash bin/android_link_native.sh"
	},
