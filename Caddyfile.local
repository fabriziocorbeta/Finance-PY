# FinancePY — Caddy local (sin ACME/TLS propio, Cloudflare Tunnel maneja HTTPS público)
:8080 {
	reverse_proxy web:3000
	encode zstd gzip

	# Los assets llevan digest en el nombre (Propshaft), así que la URL cambia cuando
	# cambia el contenido y se pueden cachear indefinidamente. Sin este header el origen
	# no manda Cache-Control y Cloudflare aplica su default (4h, sin `immutable`), lo que
	# obliga al navegador a revalidar en cada navegación: barato en desktop, caro en móvil.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# El service worker nunca debe cachearse: si se sirve con TTL, los clientes siguen
	# corriendo la versión vieja hasta que expire y no reciben los arreglos. Rails lo sirve
	# como acción dinámica (fresh_when/ETag) y ya manda su propio Cache-Control.
	#
	# `>` es el atajo documentado de Caddy para "set + defer": pisa el valor que traiga
	# el backend, aplicado recién cuando ya volvió la respuesta de reverse_proxy. El intento
	# anterior combinaba defer + -Cache-Control + Cache-Control a mano y en vivo terminó sin
	# ningún Cache-Control en la respuesta — con el atajo no hay ambigüedad de orden posible,
	# es un solo set diferido.
	@sw path /service-worker.js
	header @sw >Cache-Control "no-cache"

	# X-Content-Type-Options y X-Frame-Options NO van acá: Rails ya los manda
	# por default (config.action_dispatch.default_headers, sin override en
	# config/application.rb ni en los initializers -- ver
	# config/environments/production.rb). Ponerlos en Caddy también no rompe
	# nada (el navegador toma el primer valor si se repiten idénticos) pero
	# es una fuente de verdad duplicada que puede divergir en silencio.
	#
	# Strict-Transport-Security SÍ va acá: en este compose RAILS_FORCE_SSL=false
	# (Caddy/Cloudflare Tunnel terminan TLS, no Rails -- ver compose.local.yml
	# x-rails-env), y ActionDispatch::SSL (que es quien manda este header) solo
	# corre cuando config.force_ssl es true. Sin Caddy, este header no lo manda
	# nadie.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
